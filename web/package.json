{
  "name": "readback-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && next dev",
    "build": "npm run prepare-assets && next build",
    "build:e2e": "npm run prepare-assets && cross-env-shell NEXT_PUBLIC_READBACK_API=http://127.0.0.1:4174/mock-api next build",
    "typecheck": "tsc --noEmit",
    "serve": "node scripts/serve.mjs",
    "test:e2e": "playwright test",
    "palette": "node ../scripts/validate_palette.js --config src/theme/palette.json"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/b612": "5.3.0",
    "@fontsource/b612-mono": "5.3.0",
    "fzstd": "0.1.1",
    "hyparquet": "1.31.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "cross-env": "7.0.3",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
