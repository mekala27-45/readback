# Copy to .env for local work. Nothing here is committed with a value.
# Neon Postgres, the shared project; the readback schema is created by the migrations.
DATABASE_URL=
READBACK_DB_SCHEMA=readback
# Host names the MCP endpoint accepts (DNS rebinding protection), comma separated.
READBACK_PUBLIC_HOSTS=readback-mcp.vercel.app
# Provider keys, each optional. Without any, the floor answers.
GEMINI_API_KEY=
READBACK_GEMINI_MODEL=
READBACK_GEMINI_FALLBACK=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SAMBANOVA_API_KEY=
# A local Ollama, never in CI.
READBACK_OLLAMA_URL=
# replay (the default, and always in CI) or record (live runs within budget).
READBACK_CASSETTES=replay
OTEL_SERVICE_NAME=readback
