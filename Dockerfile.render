# The server and the API as a container, for Render free if the probe chooses it and for the out of
# process check in CI. The warehouses are fetched
# at build time from the three repositories at their pinned tags, and every file is checked against
# the lock, so the image holds exactly what the lock names. Migrations run at start, then the app,
# both from the virtual environment directly: uv run at start would re-sync without the live extra
# and rebuild every package on each cold start.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1 \
    PORT=8080 READBACK_ROOT=/app READBACK_CACHE=/tmp READBACK_CASSETTE_DIR=/tmp/cassettes READBACK_CASSETTES=record
RUN pip install --no-cache-dir "uv>=0.9,<0.10"
WORKDIR /app
COPY pyproject.toml uv.lock README.md LICENSE alembic.ini ./
COPY packages ./packages
COPY scripts ./scripts
RUN uv sync --frozen --no-dev --extra live
COPY alembic ./alembic
COPY data/warehouses.lock.json data/PROVENANCE.md ./data/
COPY catalog ./catalog
COPY prompts ./prompts
COPY providers ./providers
COPY evals/plan.yaml evals/registration.json ./evals/
RUN uv run --no-dev python scripts/fetch_warehouses.py --quiet
EXPOSE 8080
CMD ["sh", "-c", "/app/.venv/bin/alembic upgrade head && exec /app/.venv/bin/uvicorn readback_api.main:app --host 0.0.0.0 --port ${PORT:-8080} --proxy-headers --forwarded-allow-ips='*'"]
